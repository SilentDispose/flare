if(NOT DEFINED INPUT_DIR OR NOT DEFINED OUTPUT_FILE OR NOT DEFINED BUNDLE_NAME OR NOT DEFINED MANIFEST_FILE)
    message(FATAL_ERROR "embed-web-assets.cmake requires INPUT_DIR, OUTPUT_FILE, BUNDLE_NAME, and MANIFEST_FILE")
endif()

if(NOT IS_DIRECTORY "${INPUT_DIR}")
    message(FATAL_ERROR "Web asset directory does not exist: ${INPUT_DIR}")
endif()

if(NOT EXISTS "${MANIFEST_FILE}")
    message(FATAL_ERROR "Web asset manifest does not exist: ${MANIFEST_FILE}")
endif()

file(STRINGS "${MANIFEST_FILE}" webFiles)

string(REPLACE "\\" "\\\\" escapedBundle "${BUNDLE_NAME}")
string(REPLACE "\"" "\\\"" escapedBundle "${escapedBundle}")

set(declarations "")
set(entries "")
set(index 0)

foreach(relativePath IN LISTS webFiles)
    if(relativePath STREQUAL "")
        continue()
    endif()
    string(REPLACE "\\" "/" assetPath "${relativePath}")
    set(absolutePath "${INPUT_DIR}/${assetPath}")
    if(NOT EXISTS "${absolutePath}" OR IS_DIRECTORY "${absolutePath}")
        message(FATAL_ERROR "Web asset is not a file: ${absolutePath}")
    endif()
    file(READ "${absolutePath}" hexData HEX)
    string(LENGTH "${hexData}" hexLength)
    math(EXPR byteCount "${hexLength} / 2")
    if(byteCount EQUAL 0)
        set(byteLiteral "    const unsigned char asset${index}[] = {0x00};\n")
    else()
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " byteLiteral "${hexData}")
        set(byteLiteral "    const unsigned char asset${index}[] = {${byteLiteral}};\n")
    endif()
    string(APPEND declarations "${byteLiteral}")
    string(REPLACE "\\" "\\\\" escapedPath "${assetPath}")
    string(REPLACE "\"" "\\\"" escapedPath "${escapedPath}")
    string(APPEND entries "        {\"${escapedPath}\", asset${index}, ${byteCount}},\n")
    math(EXPR index "${index} + 1")
endforeach()

if(index EQUAL 0)
    message(FATAL_ERROR "Web asset directory contains no files: ${INPUT_DIR}")
endif()

file(WRITE "${OUTPUT_FILE}" "#include \"flare/embedded-web.h\"\n\nnamespace {\n\n${declarations}\nconst Flare::EmbeddedWebFile files[] = {\n${entries}    };\n\nstruct Registrar {\n    Registrar()\n    {\n        Flare::RegisterEmbeddedWebBundle(Flare::EmbeddedWebBundle {\"${escapedBundle}\", files, sizeof(files) / sizeof(files[0])});\n    }\n};\n\n[[maybe_unused]] const Registrar registrar;\n\n}\n")
